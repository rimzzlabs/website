# Build-time env, read by Astro (astro dev and astro build). Copy to .env.
# In production, set these as build variables in the Cloudflare Pages project.

# Cloudflare Turnstile SITE key. It is public and ships to the browser.
# Local test key that always passes: 1x00000000000000000000AA
PUBLIC_CF_TURNSTILE_SITE_KEY=

# --- Guestbook snapshot (build only, never sent to the browser) ---
# The build reads the newest guestbook entries through the D1 REST API and
# writes them into the static HTML. Both are optional. If they are empty, the
# page loads the entries on the client.
#   Account ID: Cloudflare dashboard, right sidebar of any domain.
#   API token: create one with the "D1 Read" permission at
#   https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
