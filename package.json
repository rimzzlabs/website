{
	"name": "rimzzlabs",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "pnpm --filter @rimzzlabs/web dev",
		"build": "pnpm --filter @rimzzlabs/web build",
		"preview": "pnpm --filter @rimzzlabs/web preview",
		"preview:functions": "pnpm --filter @rimzzlabs/web preview:functions",
		"guestbook:migrate": "pnpm --filter @rimzzlabs/web guestbook:migrate",
		"guestbook:migrate:remote": "pnpm --filter @rimzzlabs/web guestbook:migrate:remote",
		"email:dev": "pnpm --filter @rimzzlabs/mailing dev",
		"wrangler": "pnpm --filter @rimzzlabs/web exec wrangler",
		"typecheck": "pnpm --recursive typecheck",
		"format:astro": "prettier --write --plugin=prettier-plugin-astro"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"lefthook": "^2.1.14",
		"prettier": "^3.9.8",
		"prettier-plugin-astro": "^1.1.0"
	}
}
