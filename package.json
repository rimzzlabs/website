{
	"name": "@rimzzlabs/website",
	"private": true,
	"type": "module",
	"version": "2.0.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "pnpm run \"/^dev:(astro|api)$/\"",
		"dev:astro": "astro dev --host",
		"dev:api": "wrangler pages dev public --port 8788",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"ui:add": "shadcn add",
		"guestbook:migrate": "wrangler d1 migrations apply guestbook --local",
		"guestbook:migrate:remote": "wrangler d1 migrations apply guestbook --remote",
		"preview:functions": "astro build && wrangler pages dev dist",
		"email:dev": "email dev --port 5601 --dir ./src/emails",
		"email:build": "email build --packageManager pnpm"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.1",
		"@astrojs/mdx": "^8.0.1",
		"@astrojs/react": "^6.0.6",
		"@astrojs/sitemap": "^3.7.4",
		"@base-ui/react": "^1.8.0",
		"@hookform/resolvers": "^5.9.1",
		"@mobily/ts-belt": "4.0.0-rc.5",
		"@phosphor-icons/react": "^2.1.10",
		"@react-email/render": "^2.1.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.103.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"astro": "^7.3.3",
		"astro-seo": "^1.2.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"better-auth": "^1.7.6",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.3.0",
		"embla-carousel-react": "^8.6.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-email": "^6.11.0",
		"react-hook-form": "^7.88.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"resend": "^6.29.0",
		"satori": "^0.33.5",
		"shadcn": "^4.21.0",
		"sharp": "^0.35.4",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.5"
	},
	"allowScripts": {
		"esbuild": true
	},
	"devDependencies": {
		"@astrojs/ts-plugin": "^1.10.12",
		"@biomejs/biome": "^2.5.14",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@react-email/ui": "6.11.0",
		"lefthook": "^2.1.14",
		"prettier": "^3.9.8",
		"typescript": "^7.0.2",
		"wrangler": "^4.125.0"
	}
}
