---
import Link from "@/components/ui/link.astro";

interface RichLink {
  href: string;
  label: string;
  class?: string;
}

interface Props {
  text: string;
  links: Record<string, RichLink>;
}

const props = Astro.props;
const parts = props.text.split(/(\{\w+\})/g).filter(Boolean);

function toLink(part: string) {
  const match = part.match(/^\{(\w+)\}$/);
  if (!match) return null;
  return props.links[match[1]] ?? null;
}

// The link is an inline-flex box, so the browser can wrap right before a
// comma that follows it. Glue that punctuation to the link instead.
const TRAILING_PUNCTUATION = /^[,.;:!?)\]]+/;

function trailingPunctuation(index: number) {
  if (!toLink(parts[index] ?? "")) return "";
  return (parts[index + 1] ?? "").match(TRAILING_PUNCTUATION)?.[0] ?? "";
}

function withoutLeadingPunctuation(index: number) {
  const part = parts[index] ?? "";
  return part.slice(trailingPunctuation(index - 1).length);
}
---

{parts.map((part, index) => {
  const link = toLink(part);
  if (!link) return <Fragment set:html={withoutLeadingPunctuation(index)} />;
  return (
    <span class="whitespace-nowrap">
      <Link href={link.href} class={link.class}>
        {link.label}
      </Link>
      <Fragment set:html={trailingPunctuation(index)} />
    </span>
  );
})}
