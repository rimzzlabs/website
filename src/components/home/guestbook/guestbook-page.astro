---
import { PUBLIC_CF_TURNSTILE_SITE_KEY } from "astro:env/client";
import AppLayout from "@/components/shared/app-layout.astro";
import Section from "@/components/shared/section.astro";
import Seo from "@/components/shared/seo.astro";
import type { Lang } from "@/i18n/config";
import { getDictionary } from "@/i18n/dictionary";
import { getRecentCommentsAtBuild } from "@/lib/guestbook-build";
import { GuestbookButton } from "./guestbook-button";
import { GuestbookFeed } from "./guestbook-feed";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang).guestbook;
const initial = await getRecentCommentsAtBuild(10);
---

<AppLayout>
  <Seo slot="metadata" title={t.seoTitle} description={t.description} />

  <Section class="pt-12 pb-16 lg:pt-24">
    <div
      class="flex flex-col gap-6 pb-8 sm:flex-row sm:justify-between sm:gap-4"
    >
      <div>
        <h1
          class="text-4xl leading-none font-bold tracking-tight text-balance sm:text-5xl lg:text-6xl"
        >
          {t.heading}
        </h1>
        <p
          class="max-w-2xl pt-4 text-pretty text-muted-foreground lg:pt-6 lg:text-lg"
        >
          {t.description}
        </p>
      </div>

      <GuestbookButton
        lang={lang}
        client:visible
        className="sm:mt-3"
        siteKey={PUBLIC_CF_TURNSTILE_SITE_KEY}
      />
    </div>

    <GuestbookFeed
      client:visible
      lang={lang}
      initialPage={initial.items.length > 0 ? initial : undefined}
    />
  </Section>
</AppLayout>
