---
import { getDictionary, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
  class?: string;
}

const props = Astro.props;
const t = getDictionary(props.locale);
---

<p
  data-presence
  data-locale={props.locale}
  data-copy-online={t.presence.online}
  data-copy-last-active={t.presence.lastActive}
  data-copy-offline={t.presence.offline}
  hidden
  class:list={[
    "group inline-flex items-center gap-2 font-mono text-xs text-muted-foreground",
    props.class,
  ]}
>
  <span aria-hidden="true" class="relative flex size-2">
    <span class="absolute inset-0 hidden rounded-full bg-emerald-500 opacity-60 group-data-[status=online]:motion-ok:block motion-ok:animate-ping"></span>
    <span class="relative size-2 rounded-full bg-muted-foreground/50 group-data-[status=online]:bg-emerald-500"></span>
  </span>
  <span data-presence-text></span>
</p>

<script>
  import { isLocale } from "@/i18n/config";
  import {
    formatExactTime,
    PRESENCE_ENDPOINT,
    type Presence,
    presenceLabel,
    presenceSchema,
  } from "@/lib/presence";

  const POLL_MS = 60 * 1000;

  function readInitial(badge: HTMLElement) {
    const parsed = presenceSchema.safeParse({
      status: badge.dataset.status,
      lastActiveAt: badge.dataset.lastActive || null,
    });
    if (!parsed.success) return null;
    return parsed.data;
  }

  function render(badge: HTMLElement, presence: Presence) {
    const locale = badge.dataset.locale;
    const text = badge.querySelector("[data-presence-text]");
    if (!isLocale(locale) || !text) return;

    const label = presenceLabel({
      presence,
      now: Date.now(),
      locale,
      copy: {
        online: badge.dataset.copyOnline ?? "",
        lastActive: badge.dataset.copyLastActive ?? "",
        offline: badge.dataset.copyOffline ?? "",
      },
    });

    badge.dataset.status = presence.status;
    badge.dataset.lastActive = presence.lastActiveAt ?? "";
    badge.hidden = false;

    if (!presence.lastActiveAt) {
      text.textContent = label;
      return;
    }
    const time = document.createElement("time");
    time.dateTime = presence.lastActiveAt;
    time.title = formatExactTime(presence.lastActiveAt, locale);
    time.textContent = label;
    text.replaceChildren(time);
  }

  async function fetchPresence() {
    const response = await fetch(PRESENCE_ENDPOINT).catch(() => null);
    if (!response?.ok) return null;
    const parsed = presenceSchema.safeParse(await response.json());
    if (!parsed.success) return null;
    return parsed.data;
  }

  const badges = Array.from(
    document.querySelectorAll<HTMLElement>("[data-presence]"),
  );
  let current = badges.map(readInitial).find(Boolean) ?? null;

  async function refresh() {
    if (document.hidden) return;
    current = (await fetchPresence()) ?? current;
    if (!current) return;
    for (const badge of badges) render(badge, current);
  }

  if (badges.length > 0) {
    refresh();
    setInterval(refresh, POLL_MS);
    document.addEventListener("visibilitychange", refresh);
  }
</script>
