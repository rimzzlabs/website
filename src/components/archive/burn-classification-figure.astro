---
import burnStages from "@/assets/archive/burn-damage-classification.jpg";
import PhotoGallery from "@/components/media/photo-gallery/photo-gallery.astro";
import { getDictionary, type Locale } from "@/i18n";
import { toPhotoSource } from "@/lib/photo-source";

interface Props {
  locale: Locale;
}

const t = getDictionary(Astro.props.locale).archive;
const photo = await toPhotoSource({ src: burnStages, alt: t.burnAlt });
---

<figure class="mt-8">
  <PhotoGallery photos={[photo]} />
  <figcaption class="mt-2 text-sm text-pretty text-muted-foreground">
    <span class="font-medium text-foreground">{t.burnCaptionLead}</span>{" "}
    {t.burnCaption}
  </figcaption>
</figure>
