---
import {
	CheckIcon,
	CopyIcon,
	FileCodeIcon,
	TerminalWindowIcon,
} from "@phosphor-icons/react";

const LANGUAGE_LABELS: Record<string, string> = {
	ts: "TypeScript",
	typescript: "TypeScript",
	tsx: "TSX",
	js: "JavaScript",
	javascript: "JavaScript",
	jsx: "JSX",
	json: "JSON",
	css: "CSS",
	html: "HTML",
	md: "Markdown",
	mdx: "MDX",
	yaml: "YAML",
	yml: "YAML",
	sql: "SQL",
	diff: "Diff",
	bash: "Terminal",
	sh: "Terminal",
	shell: "Terminal",
	zsh: "Terminal",
	txt: "Text",
	plaintext: "Text",
};

const SHELL_LANGUAGES = new Set(["bash", "sh", "shell", "zsh"]);

const props = Astro.props;
const language: string = props["data-language"] ?? "txt";
const title: string | undefined = props["data-title"];
const label = title ?? LANGUAGE_LABELS[language] ?? language.toUpperCase();
const isShell = SHELL_LANGUAGES.has(language);
---

<div
	class="not-typeset mt-[1.5em] overflow-hidden rounded-lg border bg-card"
	data-code-block
>
	<div
		class="flex h-10 items-center justify-between gap-3 border-b bg-muted/40 pr-1.5 pl-4"
	>
		<p
			class="flex min-w-0 items-center gap-2 font-mono text-xs text-muted-foreground"
		>
			{isShell ? (
	<TerminalWindowIcon aria-hidden="true" className="size-3.5 shrink-0" />
) : (
	<FileCodeIcon aria-hidden="true" className="size-3.5 shrink-0" />
)}
			<span class="truncate">{label}</span>
		</p>

		<button
			type="button"
			data-copy-code
			class="group/copy inline-flex size-7 shrink-0 items-center justify-center rounded-md text-muted-foreground transition hover:bg-muted hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
		>
			<CopyIcon
				aria-hidden="true"
				className="size-4 group-data-copied/copy:hidden"
			/>
			<CheckIcon
				aria-hidden="true"
				className="hidden size-4 text-primary group-data-copied/copy:block"
			/>
			<span class="sr-only" aria-live="polite" data-copy-label>Copy code</span>
		</button>
	</div>

	<pre {...props}><slot /></pre>
</div>

<script>
const COPIED_MS = 2000;

document.addEventListener("click", async (event) => {
	if (!(event.target instanceof Element)) return;
	const button = event.target.closest<HTMLButtonElement>("[data-copy-code]");
	const code = button?.closest("[data-code-block]")?.querySelector("pre");
	if (!button || !code) return;

	const copied = await navigator.clipboard
		.writeText(code.textContent ?? "")
		.then(() => true)
		.catch(() => false);
	if (!copied) return;

	const label = button.querySelector("[data-copy-label]");
	button.dataset.copied = "";
	if (label) label.textContent = "Copied";

	setTimeout(() => {
		delete button.dataset.copied;
		if (label) label.textContent = "Copy code";
	}, COPIED_MS);
});
</script>
