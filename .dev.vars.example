# Runtime secrets for the Cloudflare Pages Functions in functions/.
# `wrangler pages dev` reads them from .dev.vars. Copy this file to .dev.vars
# and fill in the values. In production, set them in the Cloudflare Pages
# project: Settings > Variables and Secrets.

# --- Contact form (functions/api/contact.tsx) ---
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=

# --- Turnstile (contact form and anonymous guestbook entries) ---
# SECRET key of the same widget as PUBLIC_CF_TURNSTILE_SITE_KEY in .env.
# Local test secret that always passes: 1x0000000000000000000000000000000AA
CF_TURNSTILE_SECRET_KEY=

# --- Guestbook auth (functions/api/auth/[[all]].ts) ---
# Secret that better-auth uses to sign sessions. Generate one with:
#   openssl rand -base64 48
SESSION_SECRET=

# GitHub OAuth app. Authorization callback URL:
#   <origin>/api/auth/callback/github
# Add a second app, or a second callback, for local `wrangler pages dev`.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Guestbook rebuild ---
# Cloudflare Pages deploy hook. After a new entry, the guestbook Function calls
# it (at most once per minute) so the static snapshot of entries rebuilds.
# Pages project > Settings > Builds > Deploy hooks. Optional.
PAGES_DEPLOY_HOOK_URL=
