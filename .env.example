# Build-time env, read by Astro (astro dev / astro build). Copy to `.env`.
#
# In production these are set as build environment variables in the Cloudflare
# Pages project (Settings -> Environment variables), not from this file.

# --- Client (astro:env/client, PUBLIC_*) ---
# Baked into the static output and shipped to the browser — never a secret here.
#
# Cloudflare Turnstile SITE key (public, safe to expose). Pick your widget at:
#   https://dash.cloudflare.com/?to=/:account/turnstile
# Local testing dummy that always passes: 1x00000000000000000000AA
#   https://developers.cloudflare.com/turnstile/troubleshooting/testing/
PUBLIC_CF_TURNSTILE_SITE_KEY=

# --- Server, build-only (astro:env/server) ---
# Read at build to bake the recent guestbook comments into the static HTML
# (crawlable) via the D1 REST API. Server-only — NOT shipped to the browser.
# Both optional: if unset, the guestbook just falls back to client fetching.
# (The D1 id itself is read from wrangler.jsonc, so no need to set it here.)
#   Account id:  Cloudflare dash -> any domain -> Account ID (right sidebar)
#   API token:   create one with D1 read (Account -> D1 -> Read):
#                https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
